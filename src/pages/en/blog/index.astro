---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { useTranslations, getLocalizedPath } from '../../../i18n/utils';
import { BookOpen, Calendar, Clock, ArrowRight, Sparkles, User, Tag, ArrowLeft } from '@lucide/astro';

const lang = 'en';
const t = useTranslations(lang);

const allPosts = await getCollection('blog', ({ data }) => data.lang === lang);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('en-US', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }).format(date);
}

function getPostSlug(post: any): string {
  const cleanId = post.id.replace(/\.(md|mdx)$/, '');
  const segments = cleanId.split('/');
  return segments[segments.length - 1];
}
---

<Layout
  lang={lang}
  title="Weekly Dental & Aesthetic Blog | Koray Dental Studio"
  description="Weekly clinical guides on cosmetic smile design, 3D guided implants, clear aligners, and preventive oral health by Dr. Koray Altun."
  currentPath="/en/blog"
>
  <div class="py-16 sm:py-24 relative overflow-hidden">
    
    <!-- Background glow -->
    <div class="hero-glow-blob w-[450px] h-[450px] bg-cyan-500/15 top-0 left-1/4"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Back to Home -->
      <div class="mb-8">
        <a
          href={getLocalizedPath('/', lang)}
          class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors"
        >
          <ArrowLeft class="w-4 h-4" />
          <span>Back to Home</span>
        </a>
      </div>

      <!-- Page Header -->
      <div class="max-w-3xl mb-16 space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-600 dark:text-cyan-400 text-xs font-bold uppercase tracking-wider">
          <BookOpen class="w-3.5 h-3.5" />
          <span>WEEKLY CLINICAL DIGEST</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 dark:text-white font-['Outfit'] tracking-tight">
          Weekly Dental Health & Aesthetics Insights
        </h1>
        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          Curated every Monday by Dr. Koray Altun and our clinical team—delivering evidence-based aesthetic breakthroughs and patient care tips.
        </p>
      </div>

      <!-- Articles Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedPosts.map((post) => {
          const slug = getPostSlug(post);
          const postUrl = getLocalizedPath(`/blog/${slug}`, lang);

          return (
            <article class="group relative rounded-3xl glass-panel p-7 flex flex-col justify-between hover:border-cyan-500/50 hover:shadow-xl hover:shadow-cyan-500/10 transition-all duration-300 hover:-translate-y-1.5">
              <div>
                <!-- Week Badge -->
                <div class="flex items-center justify-between mb-4">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-cyan-500/15 text-cyan-700 dark:text-cyan-300 border border-cyan-500/30">
                    <Sparkles class="w-3 h-3 text-cyan-500" />
                    <span>Week {post.data.weekNumber}</span>
                  </span>

                  <span class="text-xs font-semibold text-slate-600 dark:text-slate-400">
                    {post.data.category}
                  </span>
                </div>

                <!-- Title -->
                <h2 class="text-xl font-bold text-slate-900 dark:text-white font-['Outfit'] leading-snug group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">
                  <a href={postUrl}>
                    {post.data.title}
                  </a>
                </h2>

                <!-- Excerpt -->
                <p class="mt-3 text-sm text-slate-600 dark:text-slate-300 line-clamp-3 leading-relaxed">
                  {post.data.description}
                </p>

                <!-- Tags -->
                <div class="flex flex-wrap gap-1.5 mt-4">
                  {post.data.tags.map((tag) => (
                    <span class="text-[10px] font-medium px-2 py-0.5 rounded-md bg-slate-100 dark:bg-white/5 text-slate-600 dark:text-slate-400">
                      #{tag}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Footer -->
              <div class="mt-8 pt-5 border-t border-slate-200/80 dark:border-white/10">
                <div class="flex items-center justify-between text-xs text-slate-600 dark:text-slate-400 mb-4">
                  <div class="flex items-center gap-1.5">
                    <Calendar class="w-3.5 h-3.5 text-cyan-500" />
                    <span>{formatDate(post.data.pubDate)}</span>
                  </div>
                  <div class="flex items-center gap-1.5">
                    <Clock class="w-3.5 h-3.5 text-cyan-500" />
                    <span>{post.data.readingTime}</span>
                  </div>
                </div>

                <div class="flex items-center justify-between">
                  <span class="text-xs font-medium text-slate-700 dark:text-slate-300">
                    {post.data.author}
                  </span>

                  <a
                    href={postUrl}
                    class="inline-flex items-center gap-1.5 text-xs font-bold text-cyan-600 dark:text-cyan-400 hover:text-cyan-500 transition-colors"
                  >
                    <span>Read Article</span>
                    <ArrowRight class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" />
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

    </div>

  </div>
</Layout>
