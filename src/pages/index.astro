---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Treatments from '../components/Treatments.astro';
import ClinicTech from '../components/ClinicTech.astro';
import DoctorProfile from '../components/DoctorProfile.astro';
import WeeklyBlogShowcase from '../components/WeeklyBlogShowcase.astro';
import AppointmentForm from '../components/AppointmentForm.astro';
---

<Layout lang="tr" currentPath="/">
  <!-- Hero Section with Motion Carousel & Crypto Scramble Badge -->
  <Hero lang="tr" />

  <!-- Clinical Treatments & Interactive Category Filter -->
  <Treatments lang="tr" />

  <!-- Clinic Atmosphere & 3D In-House Lab Technology -->
  <ClinicTech lang="tr" />

  <!-- Lead Doctor Profile & Clinical Accreditations -->
  <DoctorProfile lang="tr" />

  <!-- Weekly Dental Health Blog Showcase -->
  <WeeklyBlogShowcase lang="tr" />

  <!-- Interactive Online Appointment & Contact Inquiries -->
  <AppointmentForm lang="tr" />
</Layout>
