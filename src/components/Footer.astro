---
import type { SupportedLocale } from '../i18n/config';
import { useTranslations, getLocalizedPath } from '../i18n/utils';
import { Sparkles, MapPin, Phone, Mail, Clock, ShieldCheck, Heart, Send, Check } from '@lucide/astro';

interface Props {
  lang: SupportedLocale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="relative bg-slate-100 dark:bg-[#05080E] text-slate-700 dark:text-slate-300 border-t border-slate-200 dark:border-white/10 pt-16 pb-12 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8 pb-12 border-b border-slate-200/80 dark:border-white/10">
      
      <!-- Brand & Mission Column -->
      <div class="lg:col-span-4 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-600 via-teal-500 to-sky-400 p-[1.5px] shadow-lg shadow-cyan-500/20">
            <div class="w-full h-full bg-white dark:bg-[#090E1A] rounded-[10px] flex items-center justify-center">
              <svg class="w-5 h-5 text-cyan-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2C8.5 2 6 4.5 6 8c0 3.2 1.8 6.5 3 9.5 1 2.5 2 4.5 3 4.5s2-2 3-4.5c1.2-3 3-6.3 3-9.5 0-3.5-2.5-6-6-6z"/>
                <path d="M12 2v6"/>
              </svg>
            </div>
          </div>
          <div>
            <span class="font-extrabold text-xl text-slate-900 dark:text-white font-['Outfit'] tracking-tight">
              {t('brand.name')}
            </span>
            <span class="text-[10px] font-medium tracking-wider uppercase text-slate-600 dark:text-slate-400 block">
              {t('brand.subtitle')}
            </span>
          </div>
        </div>

        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed font-medium">
          {t('footer.tagline')}
        </p>

        <div class="space-y-2 text-xs text-slate-600 dark:text-slate-300 pt-2">
          <div class="flex items-center gap-2">
            <MapPin class="w-4 h-4 text-cyan-500 flex-shrink-0" />
            <span>{t('contact.info.address')}</span>
          </div>
          <div class="flex items-center gap-2">
            <Phone class="w-4 h-4 text-teal-500 flex-shrink-0" />
            <span>{t('contact.info.phone')}</span>
          </div>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="lg:col-span-2 space-y-4">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white font-['Outfit']">
          {t('footer.quickLinks')}
        </h4>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          <li>
            <a href={getLocalizedPath('/', lang)} class="text-slate-600 dark:text-slate-300 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">
              {t('nav.home')}
            </a>
          </li>
          <li>
            <a href={`${getLocalizedPath('/', lang)}#treatments`} class="text-slate-600 dark:text-slate-300 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">
              {t('nav.treatments')}
            </a>
          </li>
          <li>
            <a href={`${getLocalizedPath('/', lang)}#clinic`} class="text-slate-600 dark:text-slate-300 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">
              {t('nav.clinic')}
            </a>
          </li>
          <li>
            <a href={`${getLocalizedPath('/', lang)}#doctor`} class="text-slate-600 dark:text-slate-300 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">
              {t('nav.doctor')}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/blog', lang)} class="text-slate-600 dark:text-slate-300 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">
              {t('nav.blog')}
            </a>
          </li>
          <li>
            <a href={`${getLocalizedPath('/', lang)}#contact`} class="text-slate-600 dark:text-slate-300 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">
              {t('nav.contact')}
            </a>
          </li>
        </ul>
      </div>

      <!-- Popular Treatments -->
      <div class="lg:col-span-3 space-y-4">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white font-['Outfit']">
          {t('footer.treatmentsTitle')}
        </h4>
        <ul class="space-y-2 text-xs sm:text-sm text-slate-600 dark:text-slate-300">
          <li>Dijital Gülüş Tasarımı (DSD)</li>
          <li>Navigasyonlu Dikişsiz İmplant</li>
          <li>Şeffaf Plaklarla Telsiz Ortodonti</li>
          <li>Lazer Destekli Diş Beyazlatma</li>
          <li>E-Max ve Porselen Laminalar</li>
          <li>Mikroskobik Kanal Tedavisi</li>
        </ul>
      </div>

      <!-- Weekly Newsletter Subscription -->
      <div class="lg:col-span-3 space-y-4">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white font-['Outfit']">
          {t('footer.newsletterTitle')}
        </h4>
        <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
          {t('footer.newsletterDesc')}
        </p>

        <form id="newsletter-form" class="space-y-2">
          <div class="flex rounded-xl overflow-hidden border border-slate-200 dark:border-white/10 bg-white/70 dark:bg-white/5 focus-within:border-cyan-500">
            <input
              type="email"
              id="newsletter-email"
              required
              placeholder={t('footer.newsletterPlaceholder')}
              class="w-full px-3 py-2.5 text-xs text-slate-900 dark:text-white placeholder-slate-400 bg-transparent focus:outline-none"
            />
            <button
              type="submit"
              class="px-4 py-2.5 bg-cyan-600 hover:bg-cyan-500 text-white text-xs font-bold transition-colors flex items-center justify-center"
            >
              <Send class="w-3.5 h-3.5" />
            </button>
          </div>
          <p id="newsletter-success" class="hidden text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">
            {t('footer.newsletterSuccess')}
          </p>
        </form>
      </div>

    </div>

    <!-- Bottom Copyright & Legal -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-600 dark:text-slate-400">
      <p class="text-center md:text-left">
        {t('footer.copyright')}
      </p>

      <div class="flex items-center gap-4">
        <a href="#" class="hover:underline">{t('footer.privacy')}</a>
        <span>•</span>
        <a href="#" class="hover:underline">{t('footer.kvkk')}</a>
        <span>•</span>
        <a href="#" class="hover:underline">{t('footer.patientRights')}</a>
      </div>
    </div>

  </div>
</footer>

<script>
  const newsletterForm = document.getElementById('newsletter-form');
  const newsletterSuccess = document.getElementById('newsletter-success');

  newsletterForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    newsletterSuccess?.classList.remove('hidden');
    (newsletterForm as HTMLFormElement).reset();
  });
</script>
