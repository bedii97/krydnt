---
import type { SupportedLocale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';
import { Cpu, ShieldCheck, Sparkles, Activity, Eye, CheckCircle2 } from '@lucide/astro';

interface Props {
  lang: SupportedLocale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const techItems = [
  {
    title: t('clinic.tech1.title'),
    desc: t('clinic.tech1.desc'),
    tag: '20 Mikron',
    gradient: 'from-cyan-500/20 to-teal-500/10',
    iconColor: 'text-cyan-500',
  },
  {
    title: t('clinic.tech2.title'),
    desc: t('clinic.tech2.desc'),
    tag: '-%85 Radyasyon',
    gradient: 'from-emerald-500/20 to-teal-500/10',
    iconColor: 'text-emerald-500',
  },
  {
    title: t('clinic.tech3.title'),
    desc: t('clinic.tech3.desc'),
    tag: 'Aynı Gün CAD/CAM',
    gradient: 'from-blue-500/20 to-cyan-500/10',
    iconColor: 'text-blue-500',
  },
  {
    title: t('clinic.tech4.title'),
    desc: t('clinic.tech4.desc'),
    tag: 'Ağrısız Anestezi',
    gradient: 'from-purple-500/20 to-indigo-500/10',
    iconColor: 'text-purple-500',
  },
];
---

<section id="clinic" class="py-20 lg:py-28 relative overflow-hidden bg-slate-50/50 dark:bg-[#070B13]/60 border-y border-slate-200/60 dark:border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 reveal-item">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-teal-500/10 border border-teal-500/30 text-teal-600 dark:text-teal-400 text-xs font-bold uppercase tracking-wider mb-4">
        <Cpu class="w-3.5 h-3.5" />
        <span>{t('clinic.badge')}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white font-['Outfit'] tracking-tight">
        {t('clinic.title')}
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        {t('clinic.description')}
      </p>
    </div>

    <!-- Tech Grid + Interactive Before/After Showcase -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Left 4 Tech Features -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-5">
        {techItems.map((tech) => (
          <div class="reveal-item rounded-3xl glass-panel p-6 border border-slate-200/80 dark:border-white/10 hover:border-cyan-500/40 transition-all duration-300 hover:-translate-y-1">
            <div class="flex items-center justify-between mb-4">
              <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-white/5 flex items-center justify-center">
                <Sparkles class={`w-5 h-5 ${tech.iconColor}`} />
              </div>
              <span class="text-[11px] font-mono font-bold tracking-wider uppercase px-2.5 py-1 rounded-full bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20">
                {tech.tag}
              </span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white font-['Outfit']">
              {tech.title}
            </h3>
            <p class="mt-2 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              {tech.desc}
            </p>
          </div>
        ))}
      </div>

      <!-- Right: Interactive Smile Aesthetic Interactive Card -->
      <div class="lg:col-span-5 reveal-item">
        <div class="relative rounded-3xl glass-panel-glow p-6 sm:p-8 overflow-hidden">
          
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold uppercase tracking-wider text-cyan-600 dark:text-cyan-400 flex items-center gap-1.5">
              <Eye class="w-4 h-4" />
              <span>3D DSD Simülasyonu</span>
            </span>
            <span class="text-[11px] px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold border border-emerald-500/20">
              Canlı Prova
            </span>
          </div>

          <!-- Aesthetic Dental Graphic Visualizer -->
          <div class="relative w-full aspect-[4/3] rounded-2xl bg-gradient-to-br from-slate-900 via-slate-800 to-cyan-950 p-6 flex flex-col justify-between overflow-hidden border border-white/10 shadow-2xl">
            <!-- Background grid decorative lines -->
            <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff08_1px,transparent_1px),linear-gradient(to_bottom,#ffffff08_1px,transparent_1px)] bg-[size:24px_24px]"></div>

            <div class="relative z-10 flex items-center justify-between">
              <div class="space-y-1">
                <div class="text-[10px] uppercase font-mono tracking-widest text-cyan-400">Arch Ratio: 1.618 (Golden)</div>
                <div class="text-sm font-bold text-white font-['Outfit']">Estetik Lamina & Kron Dizilimi</div>
              </div>
              <div class="w-8 h-8 rounded-full bg-cyan-500/20 border border-cyan-400/40 flex items-center justify-center">
                <Activity class="w-4 h-4 text-cyan-300" />
              </div>
            </div>

            <!-- Stylized Smile Curve Graphic -->
            <div class="relative z-10 py-6">
              <svg viewBox="0 0 320 80" class="w-full h-auto text-cyan-400 filter drop-shadow-[0_0_12px_rgba(34,211,238,0.5)]">
                <path d="M 10 20 Q 160 85 310 20" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
                <!-- Tooth markers -->
                <circle cx="50" cy="33" r="5" fill="#38BDF8" />
                <circle cx="95" cy="46" r="6" fill="#38BDF8" />
                <circle cx="140" cy="52" r="7" fill="#2DD4BF" />
                <circle cx="180" cy="52" r="7" fill="#2DD4BF" />
                <circle cx="225" cy="46" r="6" fill="#38BDF8" />
                <circle cx="270" cy="33" r="5" fill="#38BDF8" />
              </svg>
              <div class="flex justify-between text-[10px] text-slate-300 font-mono mt-2 px-4">
                <span>Sol Kanin</span>
                <span>Ön Santral Kesiciler (E-Max)</span>
                <span>Sağ Kanin</span>
              </div>
            </div>

            <!-- Quick Specs Info -->
            <div class="relative z-10 grid grid-cols-2 gap-3 pt-3 border-t border-white/10">
              <div class="text-xs text-slate-300">
                <span class="text-slate-400 text-[10px] block">Materyal</span>
                <span class="font-semibold text-white">Biyolojik Lityum Disilikat</span>
              </div>
              <div class="text-xs text-slate-300">
                <span class="text-slate-400 text-[10px] block">Translusens</span>
                <span class="font-semibold text-teal-300">%94 Doğal Işık Kırılması</span>
              </div>
            </div>

          </div>

          <div class="mt-4 text-xs text-slate-600 dark:text-slate-300 flex items-center gap-2">
            <CheckCircle2 class="w-4 h-4 text-teal-500 flex-shrink-0" />
            <span>Tüm lamina ve implant protezleri kliniğimizde mikron düzeyinde üretilir.</span>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>
