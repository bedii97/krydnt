---
import type { SupportedLocale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';
import { MessageSquare, X, Send, Sparkles } from '@lucide/astro';

interface Props {
  lang: SupportedLocale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Localized pre-filled message
const defaultMsg = t('whatsapp.defaultMessage');
const encodedMsg = encodeURIComponent(defaultMsg);
const whatsappNumber = '905321234567'; // Clinic WhatsApp phone
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodedMsg}`;
---

<aside class="fixed bottom-6 right-6 z-40 flex flex-col items-end pointer-events-auto" aria-label={t('whatsapp.title')}>
  
  <!-- Mini Interactive Chat Bubble Popup (Toggled or Hovered) -->
  <div
    id="wa-popup-card"
    class="hidden mb-3 w-72 sm:w-80 rounded-2xl glass-panel-glow p-4 shadow-2xl border border-emerald-500/30 animate-in fade-in slide-in-from-bottom-2 duration-300"
  >
    <div class="flex items-center justify-between pb-3 border-b border-slate-200/80 dark:border-white/10">
      <div class="flex items-center gap-2">
        <div class="relative">
          <div class="w-8 h-8 rounded-full bg-emerald-500 text-white flex items-center justify-center font-bold text-xs shadow-md">
            KD
          </div>
          <span class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-emerald-400 border-2 border-white dark:border-slate-900"></span>
        </div>
        <div>
          <h4 class="text-xs font-bold text-slate-900 dark:text-white font-['Outfit']">
            {t('whatsapp.title')}
          </h4>
          <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-medium">
            {t('whatsapp.badge')}
          </span>
        </div>
      </div>

      <button
        type="button"
        id="wa-popup-close"
        class="text-slate-600 dark:text-slate-400 hover:text-slate-800 dark:hover:text-white p-1"
        aria-label="Kapat"
      >
        <X class="w-4 h-4" />
      </button>
    </div>

    <!-- Status Note -->
    <p class="py-3 text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
      {t('whatsapp.status')}
    </p>

    <!-- Direct CTA link to WhatsApp -->
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-emerald-600 hover:bg-emerald-500 shadow-md shadow-emerald-600/30 hover:scale-[1.02] active:scale-[0.98] transition-all"
    >
      <Send class="w-3.5 h-3.5" />
      <span>{t('whatsapp.callToAction')}</span>
    </a>
  </div>

  <!-- Floating Floating Button / Bubble -->
  <div class="relative group">
    <!-- Ping Ring -->
    <span class="absolute -inset-1 rounded-full bg-emerald-500/40 animate-ping group-hover:animate-none opacity-75"></span>
    
    <a
      id="wa-floating-btn"
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="relative flex items-center justify-center w-14 h-14 rounded-full bg-gradient-to-tr from-emerald-600 to-teal-500 text-white shadow-xl shadow-emerald-600/40 hover:shadow-emerald-600/60 hover:scale-110 active:scale-95 transition-all duration-300 focus:outline-none focus:ring-4 focus:ring-emerald-500/30"
      aria-label="WhatsApp Canlı Danışma"
    >
      <!-- Official Clean WhatsApp SVG Icon -->
      <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>
    </a>
  </div>

</aside>

<script>
  // Quick popup toggling logic
  const waBtn = document.getElementById('wa-floating-btn');
  const popup = document.getElementById('wa-popup-card');
  const closeBtn = document.getElementById('wa-popup-close');

  if (popup && closeBtn) {
    closeBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      popup.classList.add('hidden');
    });

    // On desktop, hover after 2 seconds can hint at popup, or click on mobile opens directly
    let hasShownHint = false;
    setTimeout(() => {
      if (!hasShownHint && window.innerWidth > 768) {
        popup.classList.remove('hidden');
        hasShownHint = true;
      }
    }, 4500);
  }
</script>
