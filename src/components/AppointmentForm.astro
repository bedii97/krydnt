---
import type { SupportedLocale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';
import { Calendar, Phone, Mail, User, Clock, MapPin, Send, CheckCircle2, AlertCircle, Sparkles, MessageSquare } from '@lucide/astro';

interface Props {
  lang: SupportedLocale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contact" class="py-20 lg:py-28 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 reveal-item">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-600 dark:text-cyan-400 text-xs font-bold uppercase tracking-wider mb-4">
        <Calendar class="w-3.5 h-3.5" />
        <span>{t('contact.badge')}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white font-['Outfit'] tracking-tight">
        {t('contact.title')}
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        {t('contact.description')}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Left Column: Interactive Appointment Booking Form -->
      <div class="lg:col-span-7 reveal-item">
        <div class="relative rounded-3xl glass-panel p-6 sm:p-10 border border-slate-200/80 dark:border-white/10 shadow-2xl">
          
          <!-- Normal Form State -->
          <form id="appointment-form" class="space-y-5" novalidate>
            
            <!-- Row 1: Full Name & Phone -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <!-- Full Name -->
              <div>
                <label for="appointment-name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
                  {t('contact.form.fullName')} <span class="text-rose-500">*</span>
                </label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-600 dark:text-slate-400">
                    <User class="w-4 h-4" />
                  </div>
                  <input
                    type="text"
                    id="appointment-name"
                    name="name"
                    required
                    placeholder={t('contact.form.fullNamePlaceholder')}
                    class="w-full pl-10 pr-4 py-3 rounded-xl border border-slate-200 dark:border-white/10 bg-white/50 dark:bg-slate-900/50 text-slate-900 dark:text-white placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent transition-all"
                  />
                </div>
                <p id="error-name" class="hidden mt-1 text-[11px] font-medium text-rose-500">
                  {t('contact.form.error')}
                </p>
              </div>

              <!-- Phone -->
              <div>
                <label for="appointment-phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
                  {t('contact.form.phone')} <span class="text-rose-500">*</span>
                </label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-600 dark:text-slate-400">
                    <Phone class="w-4 h-4" />
                  </div>
                  <input
                    type="tel"
                    id="appointment-phone"
                    name="phone"
                    required
                    placeholder={t('contact.form.phonePlaceholder')}
                    class="w-full pl-10 pr-4 py-3 rounded-xl border border-slate-200 dark:border-white/10 bg-white/50 dark:bg-slate-900/50 text-slate-900 dark:text-white placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent transition-all"
                  />
                </div>
                <p id="error-phone" class="hidden mt-1 text-[11px] font-medium text-rose-500">
                  {t('contact.form.error')}
                </p>
              </div>
            </div>

            <!-- Row 2: Email & Service Selector -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <!-- Email -->
              <div>
                <label for="appointment-email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
                  {t('contact.form.email')} <span class="text-rose-500">*</span>
                </label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-600 dark:text-slate-400">
                    <Mail class="w-4 h-4" />
                  </div>
                  <input
                    type="email"
                    id="appointment-email"
                    name="email"
                    required
                    placeholder={t('contact.form.emailPlaceholder')}
                    class="w-full pl-10 pr-4 py-3 rounded-xl border border-slate-200 dark:border-white/10 bg-white/50 dark:bg-slate-900/50 text-slate-900 dark:text-white placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent transition-all"
                  />
                </div>
                <p id="error-email" class="hidden mt-1 text-[11px] font-medium text-rose-500">
                  {t('contact.form.error')}
                </p>
              </div>

              <!-- Service Selection -->
              <div>
                <label for="appointment-service" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
                  {t('contact.form.service')} <span class="text-rose-500">*</span>
                </label>
                <div class="relative">
                  <select
                    id="appointment-service"
                    name="service"
                    required
                    class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-white/10 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent transition-all"
                  >
                    <option value="" disabled selected>{t('contact.form.serviceSelect')}</option>
                    <option value="dsd">Dijital Gülüş Tasarımı (DSD)</option>
                    <option value="implant">3D Navigasyonlu İmplantoloji</option>
                    <option value="ortho">Şeffaf Plaklar & Telsiz Ortodonti</option>
                    <option value="bleaching">Lazer Destekli Diş Beyazlatma</option>
                    <option value="zirconia">Zirkonyum & Porselen Kaplama</option>
                    <option value="general">Genel Muayene & Koruyucu Bakım</option>
                  </select>
                </div>
                <p id="error-service" class="hidden mt-1 text-[11px] font-medium text-rose-500">
                  {t('contact.form.error')}
                </p>
              </div>
            </div>

            <!-- Row 3: Date Picker -->
            <div>
              <label for="appointment-date" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
                {t('contact.form.date')}
              </label>
              <div class="relative">
                <input
                  type="date"
                  id="appointment-date"
                  name="date"
                  class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-white/10 bg-white/50 dark:bg-slate-900/50 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent transition-all"
                />
              </div>
            </div>

            <!-- Row 4: Message / Complaints -->
            <div>
              <label for="appointment-message" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
                {t('contact.form.message')}
              </label>
              <textarea
                id="appointment-message"
                name="message"
                rows="3"
                placeholder={t('contact.form.messagePlaceholder')}
                class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-white/10 bg-white/50 dark:bg-slate-900/50 text-slate-900 dark:text-white placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent transition-all resize-none"
              ></textarea>
            </div>

            <!-- KVKK Consent Checkbox -->
            <div class="flex items-start gap-3 pt-2">
              <input
                type="checkbox"
                id="appointment-kvkk"
                required
                class="mt-1 h-4 w-4 rounded border-slate-300 text-cyan-600 focus:ring-cyan-500"
              />
              <label for="appointment-kvkk" class="text-xs text-slate-600 dark:text-slate-300 leading-normal">
                {t('contact.form.kvkk')}
              </label>
            </div>
            <p id="error-kvkk" class="hidden text-[11px] font-medium text-rose-500">
              {t('contact.form.error')}
            </p>

            <!-- Submit Button with Spinner & States -->
            <div class="pt-2">
              <button
                type="submit"
                id="submit-btn"
                class="w-full inline-flex items-center justify-center gap-2 py-4 px-6 rounded-xl text-sm font-bold uppercase tracking-wider text-white bg-gradient-to-r from-cyan-600 via-teal-600 to-sky-600 hover:from-cyan-500 hover:via-teal-500 hover:to-sky-500 shadow-xl shadow-cyan-600/30 hover:shadow-cyan-600/50 active:scale-[0.99] transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-cyan-500"
              >
                <Send class="w-4 h-4 text-cyan-200" id="btn-icon" />
                <!-- Hidden Spinner -->
                <svg id="btn-spinner" class="hidden animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span id="btn-text">{t('contact.form.submit')}</span>
              </button>
            </div>

          </form>

          <!-- Success Card (Shown After Valid Submission) -->
          <div id="appointment-success-card" class="hidden py-8 px-4 text-center space-y-5 animate-in fade-in zoom-in-95 duration-500">
            <div class="w-16 h-16 rounded-full bg-teal-500/20 text-teal-600 dark:text-teal-400 mx-auto flex items-center justify-center shadow-lg shadow-teal-500/20">
              <CheckCircle2 class="w-10 h-10" />
            </div>

            <div class="space-y-2">
              <h3 class="text-2xl font-extrabold text-slate-900 dark:text-white font-['Outfit']">
                {t('contact.form.successTitle')}
              </h3>
              <p class="text-sm text-slate-600 dark:text-slate-300 max-w-md mx-auto">
                {t('contact.form.successDesc')}
              </p>
            </div>

            <!-- Tracking Code Box -->
            <div class="p-4 rounded-xl bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 max-w-xs mx-auto">
              <span class="text-[11px] uppercase font-bold text-slate-600 dark:text-slate-400 block">
                {t('contact.form.refCode')}
              </span>
              <span id="appointment-ref-code" class="text-lg font-mono font-bold text-cyan-600 dark:text-cyan-400">
                KRY-2026-XXXX
              </span>
            </div>

            <!-- Quick WhatsApp Bridge -->
            <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
              <a
                id="success-whatsapp-link"
                href="https://wa.me/905321234567"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-3 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-emerald-600 hover:bg-emerald-500 shadow-md shadow-emerald-600/30 transition-all"
              >
                <MessageSquare class="w-4 h-4" />
                <span>WhatsApp İle Hızlı Onay Al</span>
              </a>

              <button
                type="button"
                id="reset-form-btn"
                class="px-5 py-3 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/5 transition-colors"
              >
                {t('contact.form.reset')}
              </button>
            </div>
          </div>

        </div>
      </div>

      <!-- Right Column: Clinic Location & Hours Information -->
      <div class="lg:col-span-5 space-y-6 reveal-item">
        
        <!-- Address Card -->
        <div class="rounded-3xl glass-panel p-6 border border-slate-200/80 dark:border-white/10">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 flex items-center justify-center flex-shrink-0">
              <MapPin class="w-6 h-6" />
            </div>
            <div>
              <h4 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white font-['Outfit']">
                {t('contact.info.addressTitle')}
              </h4>
              <p class="mt-1 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                {t('contact.info.address')}
              </p>
            </div>
          </div>
        </div>

        <!-- Phone & Emergency Card -->
        <div class="rounded-3xl glass-panel p-6 border border-slate-200/80 dark:border-white/10">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-teal-500/10 text-teal-600 dark:text-teal-400 flex items-center justify-center flex-shrink-0">
              <Phone class="w-6 h-6" />
            </div>
            <div>
              <h4 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white font-['Outfit']">
                {t('contact.info.phoneTitle')}
              </h4>
              <p class="mt-1 text-sm font-semibold text-slate-900 dark:text-white">
                <a href="tel:+902122345678" class="hover:text-cyan-500 transition-colors">
                  {t('contact.info.phone')}
                </a>
              </p>
              <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
                WhatsApp Doğrudan Hat: {t('contact.info.whatsappDirect')}
              </p>
            </div>
          </div>
        </div>

        <!-- Working Hours Card -->
        <div class="rounded-3xl glass-panel p-6 border border-slate-200/80 dark:border-white/10">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-sky-500/10 text-sky-600 dark:text-sky-400 flex items-center justify-center flex-shrink-0">
              <Clock class="w-6 h-6" />
            </div>
            <div>
              <h4 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white font-['Outfit']">
                {t('contact.info.hoursTitle')}
              </h4>
              <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
                {t('contact.info.hours')}
              </p>
              <div class="mt-2 text-xs font-semibold text-cyan-600 dark:text-cyan-400 flex items-center gap-1.5">
                <Sparkles class="w-3.5 h-3.5" />
                <span>{t('contact.info.emergency')}</span>
              </div>
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  // Client-side form validation and simulated realistic submission
  const form = document.getElementById('appointment-form') as HTMLFormElement | null;
  const successCard = document.getElementById('appointment-success-card');
  const refCodeSpan = document.getElementById('appointment-ref-code');
  const resetBtn = document.getElementById('reset-form-btn');
  const submitBtn = document.getElementById('submit-btn');
  const btnText = document.getElementById('btn-text');
  const btnSpinner = document.getElementById('btn-spinner');
  const btnIcon = document.getElementById('btn-icon');

  if (form && successCard && refCodeSpan && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const nameEl = document.getElementById('appointment-name') as HTMLInputElement;
      const phoneEl = document.getElementById('appointment-phone') as HTMLInputElement;
      const emailEl = document.getElementById('appointment-email') as HTMLInputElement;
      const serviceEl = document.getElementById('appointment-service') as HTMLSelectElement;
      const kvkkEl = document.getElementById('appointment-kvkk') as HTMLInputElement;

      let isValid = true;

      // Validation checks
      if (!nameEl.value.trim()) {
        document.getElementById('error-name')?.classList.remove('hidden');
        isValid = false;
      } else {
        document.getElementById('error-name')?.classList.add('hidden');
      }

      if (!phoneEl.value.trim() || phoneEl.value.trim().length < 7) {
        document.getElementById('error-phone')?.classList.remove('hidden');
        isValid = false;
      } else {
        document.getElementById('error-phone')?.classList.add('hidden');
      }

      if (!emailEl.value.trim() || !emailEl.value.includes('@')) {
        document.getElementById('error-email')?.classList.remove('hidden');
        isValid = false;
      } else {
        document.getElementById('error-email')?.classList.add('hidden');
      }

      if (!serviceEl.value) {
        document.getElementById('error-service')?.classList.remove('hidden');
        isValid = false;
      } else {
        document.getElementById('error-service')?.classList.add('hidden');
      }

      if (!kvkkEl.checked) {
        document.getElementById('error-kvkk')?.classList.remove('hidden');
        isValid = false;
      } else {
        document.getElementById('error-kvkk')?.classList.add('hidden');
      }

      if (!isValid) return;

      // Start submission loading state
      btnText!.innerText = 'İletiliyor...';
      btnSpinner?.classList.remove('hidden');
      btnIcon?.classList.add('hidden');
      submitBtn.setAttribute('disabled', 'true');

      // Realistic API roundtrip simulation (ready to replace with fetch('/api/appointment'))
      await new Promise((resolve) => setTimeout(resolve, 900));

      // Generate random unique tracking reference
      const randomCode = `KRY-2026-${Math.floor(1000 + Math.random() * 9000)}`;
      refCodeSpan.innerText = randomCode;

      // Configure WhatsApp link
      const waLink = document.getElementById('success-whatsapp-link') as HTMLAnchorElement;
      if (waLink) {
        const waText = encodeURIComponent(`Merhaba Koray Dental Studio, randevu talebi oluşturdum. Referans Kodum: ${randomCode}. İsmim: ${nameEl.value}. Bilgi alabilir miyim?`);
        waLink.href = `https://wa.me/905321234567?text=${waText}`;
      }

      // Transition to success card
      form.classList.add('hidden');
      successCard.classList.remove('hidden');

      // Reset button
      submitBtn.removeAttribute('disabled');
      btnSpinner?.classList.add('hidden');
      btnIcon?.classList.remove('hidden');
      btnText!.innerText = 'Randevu Talebini Gönder';
    });

    resetBtn?.addEventListener('click', () => {
      form.reset();
      successCard.classList.add('hidden');
      form.classList.remove('hidden');
    });
  }
</script>
